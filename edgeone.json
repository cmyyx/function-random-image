{
  "headers": [
    {
      "source": "/img/*.avif",
      "headers": [
        { "key": "Content-Type", "value": "image/avif" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/image",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
